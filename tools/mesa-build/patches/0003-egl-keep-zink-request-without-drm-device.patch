diff --git a/src/egl/main/eglapi.c b/src/egl/main/eglapi.c
index a6c6f95..8c38af9 100644
--- a/src/egl/main/eglapi.c
+++ b/src/egl/main/eglapi.c
@@ -704,7 +704,13 @@ eglInitialize(EGLDisplay dpy, EGLint *major, EGLint *minor)
                success = _eglDriver.Initialize(disp);
             }
             if (!success) {
-               disp->Options.Zink = EGL_FALSE;
+               /* Keep zink (UTDeck): its software-style path, which presents through Vulkan WSI
+                * (kopper), is the way to reach a GPU with no DRM render node, such as Qualcomm's
+                * KGSL. Zink then takes the first Vulkan device. Used unless MESA_LOADER_DRIVER_OVERRIDE
+                * names another driver, so programs need no variable (Steam's web helper).
+                */
+               const char *override = os_get_option("MESA_LOADER_DRIVER_OVERRIDE");
+               disp->Options.Zink = !override || !*override || !strcmp(override, "zink");
                disp->Options.ForceSoftware = EGL_TRUE;
                if (!_eglDriver.Initialize(disp))
                   RETURN_EGL_ERROR(disp, EGL_NOT_INITIALIZED, EGL_FALSE);
