// UTDeck stage 3.S: UTDeck's runtime as a Steam compatibility tool (installed by steam-push.sh into
// ~/.local/share/Steam/compatibilitytools.d/utdeck). Windows games to Linux (Steam's name for this
// phone's platform too).
// The name "utdeck-proton" (stage 4.7; it was "utdeck"): Steam brings a Windows game's cloud saves
// into the prefix (pfx/drive_c/users/steamuser/...) only for a tool whose name contains "proton". One
// tool for both Wine bases: a game's runtime is its UTDECK_RUNTIME (the app's settings page).
"compatibilitytools"
{
  "compat_tools"
  {
    "utdeck-proton"
    {
      "install_path" "."
      "display_name" "UTDeck runtime"
      "from_oslist" "windows"
      "to_oslist" "linux"
    }
  }
}
