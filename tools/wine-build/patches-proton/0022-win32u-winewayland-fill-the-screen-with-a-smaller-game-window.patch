+        else if (swapchain->fill)
+        {
+            /* UTDeck fill: the compositor shows the window at another size (fullscreen was
+             * granted, or the screen turned): have the application recreate its swapchain, which
+             * then gets a host swapchain of that size. */
+            UINT width, height;
+            if (fill_target_size( surface->hwnd, &width, &height ) &&
+                (width != swapchain->host_extents.width || height != swapchain->host_extents.height))
