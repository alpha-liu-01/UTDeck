+/* UTDeck fill: win32u marks a window smaller than its monitor, whose swapchain it scales over the
+ * whole monitor, with two properties (see vulkan.c): the picture's rect in the monitor and the
+ * monitor's size. Read when the window presents a frame (with the window data locked); when they
+ * change, the window becomes (or stops being) fullscreen, with a black monitor-sized buffer under
+ * its picture so that input anywhere on the panel reaches it (wayland_pointer.c maps it back). */
+void wayland_win_data_update_fill(struct wayland_win_data *data)
+{
+    static const WCHAR fill_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l',0};
+    static const WCHAR fill_size_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l','_','s','i','z','e',0};
+    ULONG_PTR rect = (ULONG_PTR)NtUserGetProp(data->hwnd, fill_prop);
+    ULONG_PTR size = rect ? (ULONG_PTR)NtUserGetProp(data->hwnd, fill_size_prop) : 0;
+    struct wayland_surface *surface = data->wayland_surface;
+    int width = size & 0xffff, height = (size >> 16) & 0xffff;
+    BOOL on = rect && width && height;
+    RECT dst = {0};
+
+    if (on)
+    {
+        dst.left = rect & 0xffff;
+        dst.top = (rect >> 16) & 0xffff;
+        dst.right = dst.left + ((rect >> 32) & 0xffff);
+        dst.bottom = dst.top + ((rect >> 48) & 0xffff);
+    }
+    else width = height = 0;
+    if (on == data->fill_on && EqualRect(&dst, &data->fill_dst) &&
+        width == data->fill_width && height == data->fill_height)
+        return;
+
+    TRACE("hwnd=%p fill %d, picture %s in %dx%d\n", data->hwnd, on, wine_dbgstr_rect(&dst), width, height);
+    data->fill_on = on;
+    data->fill_dst = dst;
+    data->fill_width = width;
+    data->fill_height = height;
+
+    if (!surface || surface->role != WAYLAND_SURFACE_ROLE_TOPLEVEL || !surface->xdg_toplevel) return;
+    wayland_win_data_get_config(data, &surface->window);
+    wayland_surface_set_fill(surface, on, width, height);
+    wayland_win_data_update_wayland_state(data);
+}
