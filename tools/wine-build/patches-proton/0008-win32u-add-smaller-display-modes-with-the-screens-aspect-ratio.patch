From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UTDeck <utdeck@invalid>
Date: Fri, 20 Nov 2026 01:04:23 -0500
Subject: [PATCH] win32u: add smaller display modes with the screen's aspect
 ratio

---
 dlls/win32u/sysparams.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 83685fa..ce83468 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -2192,7 +2192,11 @@ static SIZE *get_screen_sizes( const DEVMODEW *maximum, const DEVMODEW *modes, U
 
     const char *env;
 
-    count = 1 + ARRAY_SIZE(default_sizes) + ARRAY_SIZE(lowres_sizes) + modes_count;
+    /* UTDeck: also smaller sizes with the screen's own aspect ratio (phones are 19.5:9 or 20:9,
+     * none of the sizes above), so that a game can render fewer pixels and still fill the screen. */
+    static const UINT native_heights[] = {540, 720, 864, 900};
+
+    count = 1 + ARRAY_SIZE(default_sizes) + ARRAY_SIZE(native_heights) + ARRAY_SIZE(lowres_sizes) + modes_count;
     if (!(sizes = malloc( count * sizeof(*sizes) ))) return NULL;
 
     count = add_screen_size( sizes, 0, max_size );
@@ -2201,6 +2205,12 @@ static SIZE *get_screen_sizes( const DEVMODEW *maximum, const DEVMODEW *modes, U
         if (default_sizes[i].cx > max_size.cx || default_sizes[i].cy > max_size.cy) continue;
         count += add_screen_size( sizes, count, default_sizes[i] );
     }
+    for (i = 0; max_size.cy && i < ARRAY_SIZE(native_heights); i++)
+    {
+        SIZE size = {.cx = (LONG)((ULONGLONG)native_heights[i] * max_size.cx / max_size.cy) & ~7, .cy = native_heights[i]};
+        if (size.cy >= max_size.cy || size.cx * 9 <= size.cy * 16) continue; /* not wider than 16:9: already listed */
+        count += add_screen_size( sizes, count, size );
+    }
 
     /* Titan Souls renders incorrectly if we report modes smaller than 800x600 */
     if ((enable_lowres = (!(env = getenv( "SteamAppId" )) || (strcmp( env, "297130" ) && strcmp( env, "403640" )))))
