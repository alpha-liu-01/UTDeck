+/* UTDeck fill (UTDECK_FILL=1): games without a render-scale option are often played in a window
+ * smaller than the panel (borderless or windowed 1200x540 on 2400x1080), as the GPU cannot draw the
+ * full resolution. Such a window is shown over the whole monitor, as gamescope does: a top-level
+ * window smaller than its monitor gets a monitor-sized host swapchain, the scaler fits its picture
+ * into it (UTDECK_SCALE), the client surface is placed at the monitor's origin, and the window is
+ * marked with two properties for the Wayland driver, which makes it fullscreen and maps input
+ * through the same rectangle: "__wine_utdeck_fill" (the picture's rect in the monitor, 16 bits each
+ * for x, y, width, height) and "__wine_utdeck_fill_size" (the monitor's size). The game itself
+ * sees its window unchanged. Launchers and dialogs have no swapchain and stay as they are. */
+/* the property names, spelled out: Unix code has no 16-bit L"" literals */
+static const WCHAR fill_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l',0};
+static const WCHAR fill_size_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l','_','s','i','z','e',0};
+static const WCHAR fill_target_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l','_','t','a','r','g','e','t',0};
+
+/* The size the window is shown at, set by the Wayland driver from the compositor's fullscreen
+ * configure: the screen in its current orientation (Lomiri gives a fullscreen window 1080x2400
+ * when the phone is upright, 2400x1080 when it is turned). Until then, the monitor's size. */
+static BOOL fill_target_size( HWND hwnd, UINT *width, UINT *height )
+{
+    ULONG_PTR size = (ULONG_PTR)NtUserGetProp( hwnd, fill_target_prop );
+    *width = size & 0xffff;
+    *height = (size >> 16) & 0xffff;
+    return *width && *height;
+}
+
+static BOOL fill_enabled(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *env = getenv( "UTDECK_FILL" );
+        on = env && *env && strcmp( env, "0" );
+    }
+    return on;
+}
+
+static BOOL window_fills_monitor( HWND hwnd, RECT *raw_monitor )
+{
+    UINT ctx;
+    struct ratio dpi;
+    MONITORINFO info;
+    RECT window;
+    BOOL ret;
+
+    if (!fill_enabled() || NtUserGetAncestor( hwnd, GA_ROOT ) != hwnd) return FALSE;
+    if (get_window_long( hwnd, GWL_STYLE ) & (WS_MINIMIZE | WS_MAXIMIZE)) return FALSE;
+    ctx = set_thread_dpi_awareness_context( NTUSER_DPI_PER_MONITOR_AWARE );
+    dpi = get_thread_dpi();
+    info = monitor_info_from_window( hwnd, MONITOR_DEFAULTTONEAREST );
+    ret = get_window_rect( hwnd, &window, dpi ) && !EqualRect( &window, &info.rcMonitor ) &&
+          window.right - window.left <= info.rcMonitor.right - info.rcMonitor.left &&
+          window.bottom - window.top <= info.rcMonitor.bottom - info.rcMonitor.top;
+    if (ret) *raw_monitor = get_monitor_physical_rect( info.rcMonitor, dpi );
+    set_thread_dpi_awareness_context( ctx );
+    return ret;
+}
+
+static void fill_set_props( HWND hwnd, const struct scaler *scaler )
+{
+    ULONG_PTR rect = (ULONG_PTR)(scaler->dst[0].x & 0xffff) |
+                     ((ULONG_PTR)(scaler->dst[0].y & 0xffff) << 16) |
+                     ((ULONG_PTR)((scaler->dst[1].x - scaler->dst[0].x) & 0xffff) << 32) |
+                     ((ULONG_PTR)((scaler->dst[1].y - scaler->dst[0].y) & 0xffff) << 48);
+    ULONG_PTR size = (scaler->host_extent.width & 0xffff) | ((ULONG_PTR)(scaler->host_extent.height & 0xffff) << 16);
+
+    TRACE( "hwnd %p: fill, picture %d,%d-%d,%d in %ux%u\n", hwnd, scaler->dst[0].x, scaler->dst[0].y,
+           scaler->dst[1].x, scaler->dst[1].y, scaler->host_extent.width, scaler->host_extent.height );
+    NtUserSetProp( hwnd, fill_size_prop, (HANDLE)size );
+    NtUserSetProp( hwnd, fill_prop, (HANDLE)rect );
+}
