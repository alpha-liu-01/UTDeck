# UTDeck stage 3.4: the defaults every game gets, in one place. Installed as wine/defaults.env by
# runtime-push.sh and read by game-run.sh (so by every Steam game through utdeck-compat). One
# NAME=value per line, no quotes, no spaces around "="; lines starting with # are skipped. A value
# already set wins: a game's own utdeck-env, GAME_ENV, or the caller's environment.
# Each line says what decided it; the measurements are in docs/ut-deck/stage3.4-defaults.md.

# Presentation without waiting for the screen's refresh: Lomiri's FIFO path deadlocked in stage
# 2.3, and MAILBOX gave the frame rates of stages 2-3.3.
MESA_VK_WSI_PRESENT_MODE=mailbox
# The portrait panel reported as a landscape monitor, so that games get landscape display modes
# (patch 0003; without it, 1280x720 fails with -2, stage 3.3).
UTDECK_WAYLAND_LANDSCAPE=1
# A game window smaller than the screen is shown filling it (patch 0010, stage 3.S).
UTDECK_FILL=1
# Wine's log for games: errors only, no fixme lines. Kept (stage 3.4, item 1): logs off and today's
# logs (this, DXVK at its default "info", VKD3D-Proton at its default) gave the same frame rates in
# every Direct3D 9, 11 and 12 and Vulkan test; they are what is read first when a game fails.
WINEDEBUG_GAME=err+all,fixme-all

# DLL choices for every game (added to WINEDLLOVERRIDES by game-run.sh, before the game's own):
# - mshtml off: no Gecko in the runtime (an HTML engine few games need; stage 3.1).
# - winemenubuilder off, as Proton does (stage 3.4, item 4): it writes Linux menu entries and file
#   types for Windows programs into the home folder (it had put Wine file types, a wine/Programs
#   menu and a 3DMark 11 entry there); it costs no start time (it runs alongside), but has no use
#   on a phone.
UTDECK_DLL_DEFAULTS=mshtml=;winemenubuilder.exe=d

# CPU boost (stage 3.5, utdeck-boost.py): uclamp_min on the game's threads, so the frequency
# governor picks higher clocks from the CPU's own table (no limit changed; the vendor's thermal
# service still steps in). ATRI, 30 minutes each way: 61.7 fps against 57.7 on average (median
# 69.0 against 65.6), the slow moments unchanged, about 2 C warmer (skin 42 C at most). A game's
# utdeck-env can turn it off (UTDECK_BOOST=0). Battery drain not measured (plugged in).
UTDECK_BOOST=1024

# Pause while locked or behind another app (stage 3.6, utdeck-pause.py, Wine patch 0015): a game started by hidden Steam is not a Lomiri
# app, so Lomiri does not freeze it, and it ran at full speed behind the lock screen (Ys IX: 3 cores,
# the GPU 98 % busy, music on). Frozen while locked or the screen is off, woken on unlock: nothing
# used meanwhile, the sound pauses by itself, picture, sound and controller come back.
UTDECK_PAUSE=1
