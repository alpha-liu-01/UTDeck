#!/bin/sh
# UTDeck stage 3.S: what Steam runs to start a Windows game with UTDeck's runtime (our custom
# compatibility tool; toolmanifest.vdf: "/utdeck-compat %verb%").
#
#   utdeck-compat VERB [ARGS...]
#
# Verbs, the same as Proton's:
#   run, waitforexitandrun   start the game (ARGS = its command line) through game-run.sh, so it
#                            gets our driver, the landscape monitor, MAILBOX, the frame statistics
#                            and the sensor log; waitforexitandrun first waits for the prefix's
#                            Wine to finish (Steam uses it after install scripts)
#   runinprefix              run ARGS with Wine in the game's prefix, nothing else
#   getcompatpath PATH       Linux path to Windows path
#   getnativepath PATH       Windows path to Linux path
#   destroyprefix            remove the game's prefix
#
# Each game has its own Wine prefix, as with Proton: $STEAM_COMPAT_DATA_PATH/pfx (pfx-proton on
# Proton's Wine base, the second tool "UTDeck runtime (Proton 11)", see UTDECK_RUNTIME below)
# (steamapps/compatdata/<appid>/pfx), made on the first start and prepared for Steam as Proton
# does: Valve's Windows Steam files from Steam's legacycompat folder in C:\Program Files (x86)\Steam,
# and the registry keys that point games at them (steam-prefix.reg). Programs are started through
# Proton's steam.exe (built into the runtime, stage 3.S step 5), which tells the Linux client which
# game runs and writes Steam's registry; a game's steamclient.dll then becomes lsteamclient (Wine
# patch 0009), which passes its calls to the Linux client. Every call is logged to
# $STEAM_COMPAT_DATA_PATH/utdeck-compat.log with the environment Steam gave, restricted to names
# that cannot hold account data (Steam also passes SteamUser, which is the account name).
set -u
VERB=${1:-}
[ $# -gt 0 ] && shift
W=/home/phablet/utdeck-probe/wine
DATA=${STEAM_COMPAT_DATA_PATH:-}
[ -n "$DATA" ] || { echo "utdeck-compat: no STEAM_COMPAT_DATA_PATH" >&2; exit 1; }
mkdir -p "$DATA"
LOG=$DATA/utdeck-compat.log
APPID=${STEAM_COMPAT_APP_ID:-${SteamAppId:-0}}
{
    echo "== $(date '+%F %T') verb=$VERB appid=$APPID"
    # printf, not echo: this sh's echo reads backslashes as escapes, and Windows paths have them
    for a in "$@"; do printf '  arg: %s\n' "$a"; done
    env | grep -E '^(STEAM_COMPAT_[A-Z_]+|SteamAppId|SteamGameId|SteamOverlayGameId|STEAM_RUNTIME[A-Z_]*|LD_PRELOAD|LD_LIBRARY_PATH|ENABLE_VK_[A-Za-z_0-9]+|DISABLE_VK_[A-Za-z_0-9]+|VK_[A-Z_]+|DISPLAY|WAYLAND_DISPLAY|SDL_[A-Z_]+|PWD)=' \
        | sed -E 's/[0-9]{15,}/(long number)/g; s/^/  env: /'
    echo "  other variables (names only): $(env | sed -n 's/^\([A-Za-z_][A-Za-z_0-9]*\)=.*/\1/p' | grep -vE '^(STEAM_COMPAT_|SteamAppId$|SteamGameId$|SteamOverlayGameId$|STEAM_RUNTIME|LD_PRELOAD$|LD_LIBRARY_PATH$|ENABLE_VK_|DISABLE_VK_|VK_|DISPLAY$|WAYLAND_DISPLAY$|SDL_|PWD$)' | sort | tr '\n' ' ')"
} >> "$LOG"

# Per-game settings: compatdata/<appid>/utdeck-env, one NAME=value per line (for example
# WINEDEBUG_GAME=+loaddll, GAME_OVERRIDES=d3dx9_43=n or GAME_ARGS=-force-vulkan), since Steam starts us with its own
# environment. Lines starting with # are skipped.
if [ -f "$DATA/utdeck-env" ]; then
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; *=*) export "$line"; printf '  per-game: %s\n' "$line" >> "$LOG" ;; esac
    done < "$DATA/utdeck-env"
fi
# The Wine base (stage 3.3): the tool Steam started picks it. "UTDeck runtime" is Hangover's Wine
# 11.16 base (the default, fully supported); "UTDeck runtime (Proton 11)" (compatibilitytools.d/
# utdeck-proton, whose script sets UTDECK_TOOL_RUNTIME=proton) is Proton 11's Wine, for the games
# that need it. UTDECK_RUNTIME in utdeck-env overrides both, for tests (env.sh picks the runtime
# from it). Each base has its own prefix: a prefix updated by one Wine is not used by the other.
# Saves inside a prefix do not move across by themselves.
export UTDECK_RUNTIME=${UTDECK_RUNTIME:-${UTDECK_TOOL_RUNTIME:-utdeck}}
case "$UTDECK_RUNTIME" in
proton) export WINEPREFIX=$DATA/pfx-proton ;;
*)      export WINEPREFIX=$DATA/pfx ;;
esac
echo "  runtime: $UTDECK_RUNTIME${UTDECK_TOOL_RUNTIME:+ (tool: $UTDECK_TOOL_RUNTIME)}, prefix $(basename "$WINEPREFIX")" >> "$LOG"
# Proton's base is not shipped by default (step 5.5): without it, say so and stop.
if [ "$UTDECK_RUNTIME" = proton ] && [ ! -x "$W/runtime-proton/bin/wine" ]; then
    echo "  Proton 11's runtime is not installed: get it with sh $W/get-runtime.sh proton" >> "$LOG"
    echo "utdeck-compat: Proton 11's runtime is not installed (sh $W/get-runtime.sh proton)" >&2
    exit 1
fi
TOOL=$(cd "$(dirname "$0")" && pwd)
STEAM=${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.local/share/Steam}

# prepare_prefix: make the prefix if needed (as game-run.sh would), then the Steam parts. The
# registry file is imported again when it changes (its checksum is kept in the prefix).
prepare_prefix() {
    (
        . $W/env.sh
        if [ ! -d "$WINEPREFIX/drive_c" ]; then
            wineboot -i > /dev/null 2>&1; wineserver -w
            echo "  prefix made" >> "$LOG"
        fi
        # The runtime's DXVK and VKD3D-Proton, whenever the prefix has not got them from this very
        # runtime (stage 4.3): not only into a prefix made here. On the Nothing Phone (1) Ys IX's
        # first launch ran through Steam's own Proton (before UTDeck's tool was Steam's default) and
        # made the prefix; ours then found it and never added DXVK, and the game stopped at once
        # ("d3d11.dll ... not found", exit 53). Also brings a prefix up to date after a runtime update.
        rt=$(head -1 "$(dirname "$(command -v wine)")/../BUILD-INFO" 2>/dev/null)
        if [ "$(cat "$DATA/utdeck-prefix-dlls" 2>/dev/null)" != "$rt" ]; then
            $W/prefix-dlls.sh > /dev/null && echo "$rt" > "$DATA/utdeck-prefix-dlls" &&
                echo "  DXVK and VKD3D-Proton put in ($rt)" >> "$LOG"
        fi
        # Wine Mono in every prefix, as Proton does (stage 3.4, item 6): Goat Simulator runs .NET
        # code and stopped with "Wine Mono is not installed" without it. On our base Wine's own
        # prefix update already installed it at a game's first start (mscoree on); Proton's base
        # did not. 241 MB and about 35 s, once per prefix.
        if [ ! -d "$WINEPREFIX/drive_c/windows/mono" ]; then
            M=$(ls "$(dirname "$(command -v wine)")"/../share/wine/mono/wine-mono-*.msi 2>/dev/null | tail -1)
            if [ -n "$M" ]; then
                t=$(date +%s)
                WINEDLLOVERRIDES="mshtml=;winemenubuilder.exe=d" wine msiexec /i "$(winepath -w "$M" 2>/dev/null)" /qn > /dev/null 2>&1
                wineserver -w
                [ -d "$WINEPREFIX/drive_c/windows/mono" ] && echo "  Wine Mono installed ($(( $(date +%s) - t )) s)" >> "$LOG" \
                    || echo "  Wine Mono install failed" >> "$LOG"
            fi
        fi
        S="$WINEPREFIX/drive_c/Program Files (x86)/Steam"
        mkdir -p "$S"
        for f in steamclient.dll steamclient64.dll GameOverlayRenderer64.dll Steam.dll; do
            [ -f "$STEAM/legacycompat/$f" ] && cp -u "$STEAM/legacycompat/$f" "$S/$f"
        done
        [ -f "$STEAM/legacycompat/SteamService.exe" ] && cp -u "$STEAM/legacycompat/SteamService.exe" "$S/steam.exe"
        # XInput: Microsoft's DLLs (the DirectX June 2010 setup of many games' install scripts puts
        # xinput1_3.dll into system32 and syswow64) talk only to Windows' Xbox controller driver,
        # which Wine does not have: the game then sees no controller (Stray). Forcing Wine's own with
        # an override is not enough (x64 programs then fail to load xinput1_3, and Unreal's launcher
        # stops with "DirectX Runtime required"); so Wine's copies go back in place, as wineboot
        # puts them.
        R=$(dirname "$(command -v wine)")/../lib/wine
        for f in xinput1_1 xinput1_2 xinput1_3 xinput1_4 xinput9_1_0; do
            for d in "system32 aarch64-windows" "syswow64 i386-windows"; do
                set -- $d
                t="$WINEPREFIX/drive_c/windows/$1/$f.dll"
                [ -f "$t" ] && [ -f "$R/$2/$f.dll" ] || continue
                head -c 512 "$t" | grep -q "Wine builtin DLL" && continue
                cp "$R/$2/$f.dll" "$t" && echo "  $1/$f.dll: Microsoft's replaced by Wine's" >> "$LOG"
            done
        done
        sum=$(sha256sum "$TOOL/steam-prefix.reg" | cut -c1-16)
        if [ "$(cat "$DATA/utdeck-prefix-reg" 2>/dev/null)" != "$sum" ]; then
            wine regedit /S "$(winepath -w "$TOOL/steam-prefix.reg" 2>/dev/null)" > /dev/null 2>&1 && wineserver -w &&
                echo "$sum" > "$DATA/utdeck-prefix-reg" && echo "  Steam registry keys imported" >> "$LOG"
        fi
        # The prefix's desktop mode. Usually native: a game window smaller than the screen (a lower
        # resolution in borderless or windowed mode) already fills the panel (fill mode, Wine patch
        # 0010), and a game's launcher keeps the whole desktop. UTDECK_RESOLUTION=WxH (per-game,
        # utdeck-env) sets a smaller mode for the whole prefix instead, for a game that only follows
        # the desktop's size; Wine scales it to the panel (patch 0006), and patch 0008's
        # screen-shaped modes (1200x540, 1600x720, 1920x864, 2000x900) fill it with no black bars.
        # setmode.exe stores the mode in the registry and Wine's explorer applies it at every start
        # of the prefix; it runs only when the setting changes, with the game's display environment
        # (landscape).
        want=${UTDECK_RESOLUTION:-native}
        if [ "$(cat "$DATA/utdeck-resolution" 2>/dev/null || echo native)" != "$want" ]; then
            out=$(WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0} UTDECK_WAYLAND_LANDSCAPE=1 DISPLAY= \
                  wine "$(winepath -w "$TOOL/setmode.exe" 2>/dev/null)" "$want" 2>&1 | grep -v -i wayland)
            wineserver -w
            printf '  %s\n' "$out" >> "$LOG"
            case "$out" in *"set and stored"*) echo "$want" > "$DATA/utdeck-resolution" ;; esac
        fi
    )
}

# fix_vc_runtime: the Visual C++ runtime of a prefix must come from one source. Steam's install
# scripts run Microsoft's Visual C++ setups, which replace a file only by a newer one: Wine's
# msvcp140 claims 14.50, so a 2015-2019 setup (up to 14.29) kept it but put Microsoft's older
# vcruntime140 under it, which Wine's msvcp140 imports; under ARM64EC that pair crashed at load
# ("MSVCP140.dll failed to initialize", Stray). Before a game starts, in system32 and syswow64:
# - if msvcp140 and vcruntime140 come from different sources (or one of them is missing), run
#   Microsoft's 2022 setup from Steam's shared folder (newer than Wine's: Microsoft's complete set,
#   ARM64X on Wine's ARM64 Windows), under FEX like the install scripts. Over an older Microsoft
#   runtime, Wine's installer removes vcruntime140.dll again while removing the old product (the
#   upgrade step); a /repair run puts it back, so missing files get one;
# - if they still differ (no 2022 setup on the phone, or a Wine claiming a newer version), put
#   Wine's own copies of the whole family back in place, as for XInput.
vc_kind() {   # vc_kind FILE: wine, microsoft or none
    [ -f "$1" ] || { echo none; return; }
    head -c 512 "$1" | grep -q "Wine builtin DLL" && echo wine || echo microsoft
}
vc_mixed() {  # the folders (system32, syswow64) where msvcp140 and vcruntime140 differ
    for d in system32 syswow64; do
        a=$(vc_kind "$WINEPREFIX/drive_c/windows/$d/msvcp140.dll")
        b=$(vc_kind "$WINEPREFIX/drive_c/windows/$d/vcruntime140.dll")
        [ "$a" != "$b" ] && printf '%s ' "$d"
    done
}
vc_complete() {  # vc_complete x64|x86: Microsoft's setup left its main files in place
    case $1 in x64) d=system32 l="msvcp140 vcruntime140 vcruntime140_1" ;; *) d=syswow64 l="msvcp140 vcruntime140" ;; esac
    for f in $l; do [ -f "$WINEPREFIX/drive_c/windows/$d/$f.dll" ] || return 1; done
}
fix_vc_runtime() {
    (
        . $W/env.sh
        mixed=$(vc_mixed)
        [ -n "$mixed" ] || exit 0
        echo "  Visual C++ runtime mixed in: $mixed" >> "$LOG"
        V="$STEAM/steamapps/common/Steamworks Shared/_CommonRedist/vcredist/2022"
        if [ -f "$V/VC_redist.x64.exe" ]; then
            for a in x64 x86; do
                for mode in install repair; do
                    [ $mode = repair ] && vc_complete $a && break
                    HODLL=libwow64fex.dll timeout 600 wine "$(winepath -w "$V/VC_redist.$a.exe")" /$mode /quiet /norestart \
                        > /dev/null 2>&1
                    echo "  Visual C++ 2022 $a /$mode: exit $?" >> "$LOG"
                    wineserver -w
                done
            done
            mixed=$(vc_mixed)
        fi
        [ -n "$mixed" ] || { echo "  Visual C++ runtime: Microsoft's complete set" >> "$LOG"; exit 0; }
        R=$(dirname "$(command -v wine)")/../lib/wine
        for d in $mixed; do
            case $d in system32) a=aarch64-windows ;; *) a=i386-windows ;; esac
            for f in msvcp140 msvcp140_1 msvcp140_2 msvcp140_atomic_wait msvcp140_codecvt_ids \
                     vcruntime140 vcruntime140_1 concrt140 vccorlib140 vcomp140; do
                [ -f "$R/$a/$f.dll" ] && cp "$R/$a/$f.dll" "$WINEPREFIX/drive_c/windows/$d/$f.dll"
            done
            echo "  Visual C++ runtime in $d: Wine's set put back" >> "$LOG"
        done
    )
}
# Steam's Vulkan layers for games stay out for now: its overlay is not wired up for our runtime, and
# its pipeline-caching layer (fossilize) is measured separately before it is allowed in.
unset ENABLE_VK_LAYER_VALVE_steam_overlay_1 ENABLE_VK_LAYER_VALVE_steam_fossilize_1
export DISABLE_VK_LAYER_VALVE_steam_fossilize_1=1
# Left from the Steam Frame build, set by the client for every game: two Vulkan layers this phone
# does not have (VK_LAYER_VALVE_rpo, VK_LAYER_VALVE_fdm_injection; the loader skips missing ones,
# but nothing of the Steam Frame belongs here) and a file through which Turnip's debug options can
# be changed while the game runs.
unset VK_INSTANCE_LAYERS TU_DEBUG_FILE
# Steam Input: for a game that uses it (Stray), Steam makes a virtual Xbox controller through the
# kernel's uinput and tells the game to ignore the real ones (SDL_GAMECONTROLLER_IGNORE_DEVICES, read
# by Wine's SDL controller backend). On Ubuntu Touch /dev/uinput belongs to an Android system user,
# so the virtual controller is never made and the game saw no controller at all. Without uinput,
# the game gets the real controller, as in games without Steam Input (no Steam remapping then).
if [ ! -w /dev/uinput ] && [ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}" ]; then
    unset SDL_GAMECONTROLLER_IGNORE_DEVICES SteamVirtualGamepadInfo
    echo "  Steam Input: no uinput, so the real controllers are passed to the game" >> "$LOG"
fi

case "$VERB" in
run|waitforexitandrun)
    [ $# -gt 0 ] || { echo "  no command line" >> "$LOG"; exit 1; }
    if [ "$VERB" = waitforexitandrun ] && [ -d "$WINEPREFIX" ]; then
        ( . $W/env.sh; wineserver -w )
    fi
    # Steam's install scripts (iscriptevaluator.exe, which starts the Steamworks redistributables'
    # installers) run their 32-bit code under FEX, not Box64: Box64 0.4.4 spins forever in the
    # Visual C++ 2015 installer (its WiX "burn" engine, 100 % of a core, no progress in 10 min); under
    # FEX it finishes in 8 s. Games keep the runtime's default until 32-bit emulators are measured.
    # Install scripts are never paused (stage 3.9): the pause helper froze Aperture Desk Job's first
    # one while the phone was locked, in the middle of the new prefix's start-up ("boot event wait
    # timed out"), and it ended with exit 29 and a half-installed Visual C++ runtime.
    # UTDECK_SETUP_RUN (stage 4.3): game-run.sh does not mark an install script as "the running game",
    # so UTDeck's library does not hide for it (it hid for Ys IX's installers on the Nothing Phone,
    # and with nothing of the app on screen Lomiri paused the app).
    case "$1" in
    */iscriptevaluator.exe) export HODLL=libwow64fex.dll UTDECK_PAUSE=0 UTDECK_SETUP_RUN=1 ;;
    esac
    prepare_prefix
    case "$1" in */iscriptevaluator.exe) ;; *) fix_vc_runtime ;; esac
    # game-run.sh sets the rest of the environment (env.sh, Wayland, overrides) and the logs, in
    # wine/games/steam-<appid>-<time>.*. It starts in Steam's working folder, as Proton does: Steam
    # sets it to the game's folder for games, and gives paths relative to it for its install
    # scripts (legacycompat\evaluatorscript_<appid>.vdf, from Steam's own folder). steam.exe is
    # Proton's builtin one ("b"), never the Valve SteamService.exe copied as Steam\steam.exe.
    # GAME_ARGS in utdeck-env (stage 3.9): more arguments for the game itself, as Steam's launch
    # options would add (for example -force-vulkan for a Unity game), not for install scripts.
    case "$1" in
    */iscriptevaluator.exe) ;;
    *) if [ -n "${GAME_ARGS:-}" ]; then
           # shellcheck disable=SC2086 # words on purpose: "-force-vulkan -screen-width 1600"
           set -- "$@" $GAME_ARGS
           echo "  game arguments added: $GAME_ARGS" >> "$LOG"
       fi ;;
    esac
    GAME_OVERRIDES="steam.exe=b${GAME_OVERRIDES:+;$GAME_OVERRIDES}" \
        "$W/game-run.sh" "steam-$APPID" "$PWD" 'C:\windows\system32\steam.exe' "$@"
    rc=$?
    echo "  exit $rc ($(date +%T))" >> "$LOG"
    exit $rc
    ;;
runinprefix)
    . $W/env.sh
    wine "$@"
    ;;
getcompatpath)
    . $W/env.sh
    wine winepath -w "$1" 2>> "$LOG"
    ;;
getnativepath)
    . $W/env.sh
    wine winepath "$1" 2>> "$LOG"
    ;;
destroyprefix)
    case "$WINEPREFIX" in
    */steamapps/compatdata/*/pfx|*/steamapps/compatdata/*/pfx-proton) rm -rf "$WINEPREFIX"; echo "  prefix removed" >> "$LOG" ;;
    *) echo "  not removing unexpected path $WINEPREFIX" >> "$LOG"; exit 1 ;;
    esac
    ;;
*)
    echo "  unknown verb" >> "$LOG"
    exit 1
    ;;
esac
