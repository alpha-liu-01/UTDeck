From: UTDeck
Subject: [PATCH] win32u, winewayland: fill the screen with a smaller game window (UTDECK_FILL)

Hangover's base's patch 0010, brought over to Proton's (stage 4.10, item B; numbered after the
patches it is written on). Games without a render-scale option are played in a window smaller than
the panel (borderless or windowed 1280x720 on 2400x1080), as the phone's GPU cannot draw the full
resolution; Lomiri shows such a window as it is, in a corner, with its top panel (Need for Speed
Most Wanted, Ys IX on this base). With UTDECK_FILL=1 the window is shown over the whole screen, as
gamescope does on the Steam Deck, while the game keeps seeing its own window size:

- win32u (vulkan.c): a top-level window smaller than its monitor (not minimized or maximized),
  outside an emulated display mode, that creates a swapchain goes through Valve's fullscreen-hack
  blit with a host swapchain of the screen's size; the picture is drawn into a rect of it chosen by
  UTDECK_SCALE (fit by default, stretch, center 1:1; "off" turns fill off, as on our base), black
  around it (the blit sampler's border). The window is marked with two properties: the picture's
  rect and the screen's size. On Hangover's base this extends our own scaler (0006), which Proton's
  base does not have.
- winewayland: when a marked window presents, it is made fullscreen, its own drawing is replaced by
  one black screen-sized buffer (so that input anywhere on the panel reaches it; there is no
  wp_viewporter on Lomiri to scale a buffer), its picture (the client surface) is placed at the
  screen's origin (Wine 11.0's driver places it itself; 11.16 asks win32u), and pointer and touch
  positions are mapped from the picture's rect back to its client area.
- The window is never resized by the compositor's configure. Instead the driver records the
  configured fullscreen size (the screen in its current orientation) in a third property; win32u
  then returns VK_SUBOPTIMAL_KHR once, the application recreates its swapchain, and the picture is
  fitted into that size.

Launchers and dialogs create no swapchain and are not affected. Exclusive fullscreen games are not
either (they cover the monitor already, or go through Valve's hack under an emulated mode).
---
diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -195,6 +195,8 @@ struct swapchain
     UINT fshack_dpi;
     VkExtent2D host_extents;
     VkFormat host_format; /* UTDeck: the host images' format, see fs_hack_host_format() */
+    BOOL fill;            /* UTDeck fill: a smaller window shown over the whole screen, see fill_get_mode() */
+    RECT fill_dst;        /* UTDeck fill: the picture's rect in the host image */
     VkCommandPool *cmd_pools; /* VkCommandPool[device->queue_count] */
     VkDeviceMemory user_image_memory;
     uint32_t n_images;
@@ -2603,6 +2605,104 @@ static BOOL surface_get_fshack_dpi( struct surface *surface )
     return fshack_enabled && dpi != raw ? raw : 0;
 }
 
+/* UTDeck fill (UTDECK_FILL=1): games without a render-scale option are often played in a window
+ * smaller than the panel (borderless or windowed 1280x720 on 2400x1080), as the GPU cannot draw the
+ * full resolution. Such a window is shown over the whole screen, as gamescope does: a top-level
+ * window smaller than its monitor, outside an emulated display mode, gets the fullscreen hack's
+ * blit with a host swapchain of the screen's size, its picture drawn into a rect of it chosen by
+ * UTDECK_SCALE (fit, the default; stretch; center, 1:1), black around it. The window is marked
+ * with two properties for the Wayland driver, which makes it fullscreen, places the picture at
+ * the screen's origin and maps input back through the same rect: "__wine_utdeck_fill" (the
+ * picture's rect, 16 bits each for x, y, width, height) and "__wine_utdeck_fill_size" (the
+ * screen's size). The game itself sees its window unchanged. Launchers and dialogs have no
+ * swapchain and stay as they are. The same as patch 0010 on Hangover's Wine, where it extends our
+ * own scaler (0006) instead of Valve's. */
+/* the property names, spelled out: Unix code has no 16-bit L"" literals */
+static const WCHAR fill_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l',0};
+static const WCHAR fill_size_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l','_','s','i','z','e',0};
+static const WCHAR fill_target_prop[] = {'_','_','w','i','n','e','_','u','t','d','e','c','k','_','f','i','l','l','_','t','a','r','g','e','t',0};
+
+enum fill_mode { FILL_OFF, FILL_FIT, FILL_STRETCH, FILL_CENTER };
+
+static enum fill_mode fill_get_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0)
+    {
+        const char *fill = getenv( "UTDECK_FILL" ), *scale = getenv( "UTDECK_SCALE" );
+        if (!fill || !*fill || !strcmp( fill, "0" )) mode = FILL_OFF;
+        else if (!scale || !*scale || !strcmp( scale, "fit" )) mode = FILL_FIT;
+        else if (!strcmp( scale, "stretch" )) mode = FILL_STRETCH;
+        else if (!strcmp( scale, "center" )) mode = FILL_CENTER;
+        else mode = FILL_OFF;  /* UTDECK_SCALE=off: no scaling, so no fill either, as on our base */
+    }
+    return mode;
+}
+
+/* The size the window is shown at, set by the Wayland driver from the compositor's fullscreen
+ * configure: the screen in its current orientation. Until then, the monitor's size. */
+static BOOL fill_target_size( HWND hwnd, UINT *width, UINT *height )
+{
+    ULONG_PTR size = (ULONG_PTR)NtUserGetProp( hwnd, fill_target_prop );
+    *width = size & 0xffff;
+    *height = (size >> 16) & 0xffff;
+    return *width && *height;
+}
+
+/* A top-level window, neither minimized nor maximized, smaller than its monitor: the monitor's
+ * size in real pixels. */
+static BOOL window_fills_monitor( HWND hwnd, VkExtent2D *size )
+{
+    MONITORINFO info;
+    RECT window, raw;
+    UINT ctx, dpi;
+    BOOL ret;
+
+    if (fill_get_mode() == FILL_OFF || NtUserGetAncestor( hwnd, GA_ROOT ) != hwnd) return FALSE;
+    if (get_window_long( hwnd, GWL_STYLE ) & (WS_MINIMIZE | WS_MAXIMIZE)) return FALSE;
+    ctx = set_thread_dpi_awareness_context( NTUSER_DPI_PER_MONITOR_AWARE );
+    dpi = get_thread_dpi();
+    info = monitor_info_from_window( hwnd, MONITOR_DEFAULTTONEAREST );
+    ret = get_window_rect( hwnd, &window, dpi ) && !EqualRect( &window, &info.rcMonitor ) &&
+          window.right - window.left <= info.rcMonitor.right - info.rcMonitor.left &&
+          window.bottom - window.top <= info.rcMonitor.bottom - info.rcMonitor.top;
+    if (ret)
+    {
+        raw = map_rect_virt_to_raw( info.rcMonitor, dpi );
+        size->width = raw.right - raw.left;
+        size->height = raw.bottom - raw.top;
+        ret = size->width && size->height;
+    }
+    set_thread_dpi_awareness_context( ctx );
+    return ret;
+}
+
+/* Where the game's picture (src) goes in the host image (dst), by UTDECK_SCALE. */
+static RECT fill_place( VkExtent2D src, VkExtent2D dst )
+{
+    UINT sw = max( src.width, 1 ), sh = max( src.height, 1 ), dw = dst.width, dh = dst.height, w, h;
+    RECT rect;
+
+    if (fill_get_mode() == FILL_STRETCH) { w = dw; h = dh; }
+    else if (fill_get_mode() == FILL_CENTER && sw <= dw && sh <= dh) { w = sw; h = sh; }
+    else if ((UINT64)sw * dh > (UINT64)sh * dw) { w = dw; h = max( 1, (UINT)((UINT64)sh * dw / sw) ); }
+    else { h = dh; w = max( 1, (UINT)((UINT64)sw * dh / sh) ); }
+    SetRect( &rect, (dw - w) / 2, (dh - h) / 2, (dw - w) / 2 + w, (dh - h) / 2 + h );
+    return rect;
+}
+
+static void fill_set_props( HWND hwnd, const RECT *dst, VkExtent2D size )
+{
+    ULONG_PTR rect = (ULONG_PTR)(dst->left & 0xffff) | ((ULONG_PTR)(dst->top & 0xffff) << 16) |
+                     ((ULONG_PTR)((dst->right - dst->left) & 0xffff) << 32) |
+                     ((ULONG_PTR)((dst->bottom - dst->top) & 0xffff) << 48);
+    ULONG_PTR extent = (size.width & 0xffff) | ((ULONG_PTR)(size.height & 0xffff) << 16);
+
+    TRACE( "hwnd %p: fill, picture %s in %ux%u\n", hwnd, wine_dbgstr_rect( dst ), size.width, size.height );
+    NtUserSetProp( hwnd, fill_size_prop, (HANDLE)extent );
+    NtUserSetProp( hwnd, fill_prop, (HANDLE)rect );
+}
+
