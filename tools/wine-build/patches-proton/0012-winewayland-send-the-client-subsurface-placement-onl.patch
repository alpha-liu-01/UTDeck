From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UTDeck <utdeck@invalid>
Date: Fri, 20 Nov 2026 16:05:46 -0500
Subject: [PATCH] winewayland: send the client subsurface placement only when
 it changes

win32u updates a window's client surface (the game's picture) before and after every Vulkan
present. Each update repositioned and restacked the client subsurface and committed the parent
surface, so a game sent three commits per frame instead of one, and Lomiri logged "place_above
not implemented" for each. Remember the placement last sent, with its parent surface, and send
and commit only a change. (Stage 3.3 first suspected these commits of doubling the GPU time per
frame against Proton 11's Wine; with this patch the speed did not change: the gap came from
Proton's picture not being shown. Kept because it removes work and log noise.)

Ported to Proton 11.0: its placement is x, y, width and height (no rect), and it is only set from
wayland_client_surface_attach().
---
 dlls/winewayland.drv/wayland_surface.c | 21 +++++++++++++++++----
 dlls/winewayland.drv/waylanddrv.h      |  4 ++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 392bc23..033e999 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -634,10 +634,11 @@ static void wayland_surface_reconfigure_size(struct wayland_surface *surface,
  *
  * Reconfigures the subsurface covering the client area.
  */
-static void wayland_surface_reconfigure_client(struct wayland_surface *surface,
+static BOOL wayland_surface_reconfigure_client(struct wayland_surface *surface,
                                                struct wayland_client_surface *client,
                                                const RECT *client_rect)
 {
+    RECT rect;
     struct wayland_window_config *window = &surface->window;
     int client_x, client_y, x, y;
     int client_width, client_height, width, height;
@@ -653,6 +654,16 @@ static void wayland_surface_reconfigure_client(struct wayland_surface *surface,
     wayland_surface_coords_from_window(surface, client_width, client_height,
                                        &width, &height);
 
+    /* win32u updates the client surface before and after every present. Sending the same
+     * position, stacking and size again and committing the parent each time adds two commits per
+     * frame and fills Lomiri's log (it does not implement place_above), so only a change is
+     * sent. */
+    SetRect(&rect, x, y, x + width, y + height);
+    if (client->applied_parent == surface->wl_surface && EqualRect(&client->applied_rect, &rect))
+        return FALSE;
+    client->applied_parent = surface->wl_surface;
+    client->applied_rect = rect;
+
     TRACE("hwnd=%p subsurface=%d,%d+%dx%d\n", surface->hwnd, x, y, width, height);
 
     if (client->wl_subsurface)
@@ -661,12 +672,13 @@ static void wayland_surface_reconfigure_client(struct wayland_surface *surface,
         wl_subsurface_place_above(client->wl_subsurface, surface->wl_surface);
     }
 
-    if (!client->wp_viewport) return; /* no wp_viewporter: shown at its buffer size */
+    if (!client->wp_viewport) return TRUE; /* no wp_viewporter: shown at its buffer size */
 
     if (width != 0 && height != 0)
         wp_viewport_set_destination(client->wp_viewport, width, height);
     else /* We can't have a 0x0 destination, use 1x1 instead. */
         wp_viewport_set_destination(client->wp_viewport, 1, 1);
+    return TRUE;
 }
 
 /**********************************************************************
@@ -1168,6 +1180,7 @@ void wayland_client_surface_attach(struct wayland_client_surface *client, HWND t
         }
 
         client->toplevel = 0;
+        client->applied_parent = NULL;
         return;
     }
 
@@ -1199,9 +1212,9 @@ void wayland_client_surface_attach(struct wayland_client_surface *client, HWND t
     NtUserGetClientRect(hwnd, &client_rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI));
     NtUserMapWindowPoints(hwnd, toplevel, (POINT *)&client_rect, 2, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI));
 
-    wayland_surface_reconfigure_client(surface, client, &client_rect);
     /* Commit to apply subsurface positioning. */
-    wl_surface_commit(surface->wl_surface);
+    if (wayland_surface_reconfigure_client(surface, client, &client_rect))
+        wl_surface_commit(surface->wl_surface);
 }
 
 static void dummy_buffer_release(void *data, struct wl_buffer *buffer)
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index ad6db21..97f9879 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -247,6 +247,10 @@ struct wayland_client_surface
     struct wl_surface *wl_surface;
     struct wl_subsurface *wl_subsurface;
     struct wp_viewport *wp_viewport;
+    /* The subsurface placement last sent to the compositor (surface coordinates) and the parent
+     * it was sent for, so an unchanged placement is not sent and committed again each frame. */
+    RECT applied_rect;
+    struct wl_surface *applied_parent;
 };
 
 struct wayland_shm_buffer
