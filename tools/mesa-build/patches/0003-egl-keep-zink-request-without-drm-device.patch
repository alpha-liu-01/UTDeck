diff --git a/src/egl/main/eglapi.c b/src/egl/main/eglapi.c
index a6c6f95..8c38af9 100644
--- a/src/egl/main/eglapi.c
+++ b/src/egl/main/eglapi.c
@@ -704,7 +704,13 @@ eglInitialize(EGLDisplay dpy, EGLint *major, EGLint *minor)
                success = _eglDriver.Initialize(disp);
             }
             if (!success) {
-               disp->Options.Zink = EGL_FALSE;
+               /* Keep an explicit request for zink (MESA_LOADER_DRIVER_OVERRIDE=zink): its
+                * software-style path, which presents through Vulkan WSI (kopper), is also the way
