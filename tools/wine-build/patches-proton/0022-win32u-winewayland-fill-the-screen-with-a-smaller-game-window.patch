                                              const VkAllocationCallbacks *allocator, VkSwapchainKHR *ret )
 {
@@ -2615,6 +2715,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     VkSwapchainCreateInfoKHR create_info_host = *create_info;
     VkSurfaceCapabilitiesKHR capabilities;
     VkSwapchainKHR host_swapchain;
+    VkExtent2D fill_size = {0};
     RECT client_rect;
     VkResult res;
 
@@ -2653,7 +2754,23 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
 
     if (!(swapchain = calloc( 1, sizeof(*swapchain) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
 
-    if ((swapchain->fshack_dpi = surface_get_fshack_dpi( surface )))
+    swapchain->fshack_dpi = surface_get_fshack_dpi( surface );
+    /* UTDeck fill: a window smaller than its monitor, outside an emulated mode, through the same
+     * blit, into a host swapchain of the screen's size (the size the compositor shows the window
+     * at, once the Wayland driver knows it) */
+    if (!swapchain->fshack_dpi && window_fills_monitor( surface->hwnd, &fill_size ))
+    {
+        UINT width, height;
+        if (fill_target_size( surface->hwnd, &width, &height ))
+        {
+            fill_size.width = width;
+            fill_size.height = height;
+        }
+        swapchain->fill = TRUE;
+        swapchain->fill_dst = fill_place( create_info->imageExtent, fill_size );
+    }
+
+    if (swapchain->fshack_dpi || swapchain->fill)
     {
         VkSurfaceCapabilitiesKHR caps = {0};
 
@@ -2673,7 +2790,8 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
          * real pixels. On X11 the surface's minimum size is the window's; a Wayland surface has no
          * size of its own (currentExtent 0xFFFFFFFF, minImageExtent 1x1), so the picture was
          * scaled to 1x1 and nothing showed (Lomiri). Use the client area at the raw DPI instead. */
-        if (capabilities.currentExtent.width == 0xFFFFFFFF &&
+        if (swapchain->fill) swapchain->host_extents = fill_size;
+        else if (capabilities.currentExtent.width == 0xFFFFFFFF &&
             get_surface_rect( surface->hwnd, &client_rect, swapchain->fshack_dpi ) &&
             client_rect.right > 0 && client_rect.bottom > 0)
         {
@@ -2702,7 +2820,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     swapchain->extents = create_info->imageExtent;
     instance->p_insert_object( instance, &swapchain->obj.obj );
 
-    if (swapchain->fshack_dpi)
+    if (swapchain->fshack_dpi || swapchain->fill)
     {
         if ((res = init_fs_hack_images( device, swapchain, create_info )))
         {
@@ -2724,6 +2842,10 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
               debugstr_vkextent2d(&swapchain->extents), debugstr_vkextent2d(&swapchain->host_extents) );
     }
 
+    /* UTDeck fill: tell the Wayland driver, or that it is over */
+    if (swapchain->fill) fill_set_props( surface->hwnd, &swapchain->fill_dst, swapchain->host_extents );
+    else if (NtUserGetProp( surface->hwnd, fill_prop )) NtUserRemoveProp( surface->hwnd, fill_prop );
+
     *ret = swapchain->obj.client.swapchain;
     return VK_SUCCESS;
 }
@@ -2738,7 +2860,7 @@ void win32u_vkDestroySwapchainKHR( VkDevice client_device, VkSwapchainKHR client
     if (allocator) FIXME( "Support for allocation callbacks not implemented yet\n" );
     if (!swapchain) return;
 
-    if (swapchain->fshack_dpi)
+    if (swapchain->fshack_dpi || swapchain->fill)
     {
         for (uint32_t i = 0; i < swapchain->n_images; ++i)
         {
@@ -2839,7 +2961,7 @@ static VkResult win32u_vkGetSwapchainImagesKHR( VkDevice client_device, VkSwapch
     struct swapchain *swapchain = swapchain_from_handle( client_swapchain );
     uint32_t i;
 
-    if (images && swapchain->fshack_dpi)
+    if (images && (swapchain->fshack_dpi || swapchain->fill))
     {
         if (*count > swapchain->n_images) *count = swapchain->n_images;
         for (i = 0; i < *count; ++i) images[i] = swapchain->fs_hack_images[i].user_image;
@@ -2890,6 +3012,7 @@ static VkResult record_compute_cmd( struct vulkan_device *device, struct swapcha
     VkImageMemoryBarrier barriers[3] = {{0}};
     VkCommandBufferBeginInfo beginInfo = {0};
     float constants[4];
+    RECT dst;
 
     TRACE( "recording compute command\n" );
 
@@ -2939,17 +3062,22 @@ static VkResult record_compute_cmd( struct vulkan_device *device, struct swapcha
     device->p_vkCmdBindDescriptorSets( hack->cmd, VK_PIPELINE_BIND_POINT_COMPUTE,
                                        swapchain->pipeline_layout, 0, 1, &hack->descriptor_set, 0, NULL );
 
+    /* UTDeck fill: the picture goes into its rect of the host image, black around it (the
+     * sampler's border); otherwise over the whole host image, as before */
+    if (swapchain->fill) dst = swapchain->fill_dst;
+    else SetRect( &dst, 0, 0, swapchain->host_extents.width, swapchain->host_extents.height );
+
     /* vec2: blit dst offset in real coords */
-    constants[0] = 0;
-    constants[1] = 0;
+    constants[0] = dst.left;
+    constants[1] = dst.top;
 
     /* offset by 0.5f because sampling is relative to pixel center */
-    constants[0] -= 0.5f * swapchain->host_extents.width / swapchain->extents.width;
-    constants[1] -= 0.5f * swapchain->host_extents.height / swapchain->extents.height;
+    constants[0] -= 0.5f * (dst.right - dst.left) / swapchain->extents.width;
+    constants[1] -= 0.5f * (dst.bottom - dst.top) / swapchain->extents.height;
 
     /* vec2: blit dst extents in real coords */
-    constants[2] = swapchain->host_extents.width;
-    constants[3] = swapchain->host_extents.height;
+    constants[2] = dst.right - dst.left;
+    constants[3] = dst.bottom - dst.top;
     device->p_vkCmdPushConstants( hack->cmd, swapchain->pipeline_layout,
                                   VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants), constants );
 
@@ -3024,7 +3152,7 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
         struct swapchain *swapchain = swapchain_from_handle( present_info->pSwapchains[i] );
         struct fs_hack_image *hack = &swapchain->fs_hack_images[present_info->pImageIndices[i]];
 
-        if (!swapchain->fshack_dpi) continue;
+        if (!swapchain->fshack_dpi && !swapchain->fill) continue;
         blit_sema = hack->blit_finished;
 
