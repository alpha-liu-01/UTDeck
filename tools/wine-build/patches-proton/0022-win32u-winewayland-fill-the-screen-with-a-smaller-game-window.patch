+/* UTDeck fill: set or clear; new contents are attached at the next flush or present */
+void wayland_surface_set_fill(struct wayland_surface *surface, BOOL on, int width, int height)
+{
+    on = on && width > 0 && height > 0;
+    if (on == surface->fill_on && (!on || (width == surface->fill_width && height == surface->fill_height)))
+        return;
+    surface->fill_on = on;
+    surface->fill_width = on ? width : 0;
+    surface->fill_height = on ? height : 0;
+    surface->content_width = surface->content_height = 0;
+}
+
+/* UTDeck fill: the window's own drawing is replaced by one black buffer of the screen's size (the
+ * picture is the client surface above it); it never changes, so it is attached again as it is. */
+static void wayland_surface_attach_fill(struct wayland_surface *surface)
+{
+    int width = surface->fill_width, height = surface->fill_height;
+
+    if (surface->fill_buffer &&
+        (surface->fill_buffer->width != width || surface->fill_buffer->height != height))
+    {
+        wayland_shm_buffer_unref(surface->fill_buffer);
+        surface->fill_buffer = NULL;
+    }
+    if (!surface->fill_buffer)
+    {
+        if (!(surface->fill_buffer = wayland_shm_buffer_create(width, height, WL_SHM_FORMAT_XRGB8888)))
+        {
+            ERR("Failed to create the %dx%d fill buffer\n", width, height);
+            return;
+        }
+        memset(surface->fill_buffer->map_data, 0, (size_t)width * height * WINEWAYLAND_BYTES_PER_PIXEL);
+    }
+    wl_surface_attach(surface->wl_surface, surface->fill_buffer->wl_buffer, 0, 0);
+    wl_surface_damage_buffer(surface->wl_surface, 0, 0, width, height);
+    surface->content_width = width;
+    surface->content_height = height;
+}
