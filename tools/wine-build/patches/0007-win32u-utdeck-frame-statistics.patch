+/* UTDeck: frame statistics for measuring games. When UTDECK_FRAMESTATS names a file ("-" for
+ * stderr), every process appends one line per second: frames presented, frame rate, mean and
+ * longest time between presents, and the swapchain size. Off (one getenv) otherwise. */
+static void framestats_present( const struct swapchain *swapchain )
+{
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static int state = -1; /* -1: not read yet, 0: off, 1: on */
+    static FILE *out;
+    static double start, window_start, last, sum_dt, max_dt;
+    static unsigned int frames, total;
+    struct timespec ts;
+    double now;
+
+    if (!state) return;
+    pthread_mutex_lock( &lock );
+    if (state < 0)
+    {
+        const char *path = getenv( "UTDECK_FRAMESTATS" );
+        state = 0;
+        if (path && *path && (out = strcmp( path, "-" ) ? fopen( path, "a" ) : stderr))
+        {
+            setvbuf( out, NULL, _IOLBF, 0 );
+            state = 1;
+        }
+        if (!state)
+        {
+            pthread_mutex_unlock( &lock );
+            return;
+        }
+    }
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    now = ts.tv_sec + ts.tv_nsec / 1e9;
+    if (!total) start = window_start = now;
+    else
+    {
+        double dt = now - last;
+        sum_dt += dt;
+        if (dt > max_dt) max_dt = dt;
+        frames++;
+    }
+    total++;
+    last = now;
+    if (frames && now - window_start >= 1.0)
+    {
+        fprintf( out, "utdeck-frames: pid %d, t %.1f s, %u frames in %.2f s, %.1f fps, frame time mean %.2f ms, max %.2f ms, %ux%u\n",
+                 (int)getpid(), now - start, frames, now - window_start, frames / (now - window_start),
+                 sum_dt * 1000 / frames, max_dt * 1000, swapchain->extents.width, swapchain->extents.height );
+        window_start = now;
+        frames = 0;
+        sum_dt = max_dt = 0;
+    }
+    pthread_mutex_unlock( &lock );
+}
+
 struct semaphore
 {
     struct vulkan_semaphore obj;
